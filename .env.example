# 스위치는 이 파일 한 곳입니다. 복사:  cp .env.example .env
# 수업 당일(토·휴장)은 mock 그대로 — 연습 계좌가 체결된 것처럼 움직입니다.
KIS_MODE=mock
# 평일에 증권사 모의투자로 붙이려면 mock → live 로만 바꾸세요. 코드는 그대로입니다.
# KIS_MODE=live
KIS_APP_KEY=여기에_모의투자_앱키
KIS_APP_SECRET=여기에_모의투자_시크릿
KIS_ACCOUNT=모의계좌_앞8자리
# 실전(수업 밖). 켜지 마세요. 켜려면 두 줄 모두:
# KIS_ENV=real
# KIS_REAL_ACK=REAL-MONEY-OK

# (선택) 텔레그램. 3~4회차와 같은 이름입니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
